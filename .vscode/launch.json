{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "stdio",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/clients/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/clients/vscode/dist/**/*.js"
      ],
      "env": {
        "LSPF_ANALYSIS_DEBUG_PORT": null,
        "LSPF_ANALYSIS_DEBUG_TCP": null,
        "LSPF_ANALYSIS_DEBUG_TRANSPORT": null,
        "LSPF_ANALYSIS_DEBUG_LOG": null,
        "RUST_LOG": "debug"
      },
      "preLaunchTask": "prepare debug session",
      "presentation": {
        "group": "transports",
        "order": 1
      }
    },
    {
      "name": "tcp server",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/lspf-analysis",
      "args": [
        "serve",
        "--tcp",
        "127.0.0.1:9257"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_LOG": "debug"
      },
      "sourceLanguages": [
        "rust"
      ],
      "presentation": {
        "hidden": true
      },
      "terminal": "integrated"
    },
    {
      "name": "tcp extension host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/clients/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/clients/vscode/dist/**/*.js"
      ],
      "env": {
        "LSPF_ANALYSIS_DEBUG_PORT": "9257",
        "LSPF_ANALYSIS_DEBUG_TRANSPORT": "tcp",
        "LSPF_ANALYSIS_DEBUG_TCP": null,
        "LSPF_ANALYSIS_DEBUG_LOG": null
      },
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "websocket server",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/lspf-analysis",
      "args": [
        "serve",
        "--ws",
        "127.0.0.1:9258"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_LOG": "debug"
      },
      "sourceLanguages": [
        "rust"
      ],
      "presentation": {
        "hidden": true
      },
      "terminal": "integrated"
    },
    {
      "name": "websocket extension host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/clients/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/clients/vscode/dist/**/*.js"
      ],
      "env": {
        "LSPF_ANALYSIS_DEBUG_PORT": "9258",
        "LSPF_ANALYSIS_DEBUG_TRANSPORT": "ws",
        "LSPF_ANALYSIS_DEBUG_TCP": null,
        "LSPF_ANALYSIS_DEBUG_LOG": null
      },
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "tcp",
      "configurations": [
        "tcp server",
        "tcp extension host"
      ],
      "preLaunchTask": "prepare debug session",
      "stopAll": true,
      "presentation": {
        "group": "transports",
        "order": 2
      }
    },
    {
      "name": "websocket",
      "configurations": [
        "websocket server",
        "websocket extension host"
      ],
      "preLaunchTask": "prepare debug session",
      "stopAll": true,
      "presentation": {
        "group": "transports",
        "order": 3
      }
    }
  ]
}
