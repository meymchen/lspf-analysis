<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- This console host has no UI/JTF context; awaiting remote replies is intentional. -->
    <NoWarn>$(NoWarn);VSTHRD003</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IntermediateOutputPath>obj/Health/</IntermediateOutputPath>
    <OutputPath>bin/HealthProtocol/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="HealthSmoke.cs" />
    <Compile Include="..\HealthProtocol.cs" Link="HealthProtocol.cs" />
    <Compile Include="..\ServerProcess.cs" Link="ServerProcess.cs" />
    <Compile Include="..\DebugWebSocketStream.cs" Link="DebugWebSocketStream.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="StreamJsonRpc" Version="2.8.28" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>
</Project>
