{
  "name": "lspf-analysis",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "preview": true,
  "publisher": "meymchen",
  "author": {
    "name": "Yuming Chen"
  },
  "private": true,
  "license": "MPL-2.0",
  "icon": "images/icon.png",
  "homepage": "https://github.com/meymchen/lspf-analysis/tree/main/clients/vscode#readme",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#191d23",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/meymchen/lspf-analysis.git",
    "directory": "clients/vscode"
  },
  "bugs": {
    "url": "https://github.com/meymchen/lspf-analysis/issues"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "code health",
    "code quality",
    "cognitive complexity",
    "cyclomatic complexity",
    "static analysis",
    "metrics",
    "language server",
    "C++",
    "Java",
    "JavaScript",
    "Python",
    "Rust",
    "TypeScript"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:java",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:python",
    "onLanguage:rust",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lspfAnalysis.restartServer",
        "title": "%command.restartServer.title%",
        "category": "%command.category%"
      },
      {
        "command": "lspfAnalysis.goToSource",
        "title": "%command.goToSource.title%",
        "category": "%command.category%"
      },
      {
        "command": "lspfAnalysis.sortByQuality",
        "title": "%command.sortByQuality.title%",
        "category": "%command.category%",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "lspfAnalysis.sortByPosition",
        "title": "%command.sortByPosition.title%",
        "category": "%command.category%",
        "icon": "$(list-ordered)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "lspfAnalysis.codeHealth",
          "name": "%view.codeHealth.name%",
          "icon": "$(pulse)",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lspfAnalysis.codeHealth",
        "contents": "%viewsWelcome.codeHealth%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "lspfAnalysis.goToSource",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "lspfAnalysis.sortByQuality",
          "when": "view == lspfAnalysis.codeHealth && lspfAnalysis.sort == position",
          "group": "navigation"
        },
        {
          "command": "lspfAnalysis.sortByPosition",
          "when": "view == lspfAnalysis.codeHealth && lspfAnalysis.sort == quality",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "lspfAnalysis.health.complexityThreshold": {
          "type": "number",
          "default": 15,
          "exclusiveMinimum": 0,
          "markdownDescription": "%config.health.complexityThreshold%"
        },
        "lspfAnalysis.health.cyclomaticThreshold": {
          "type": "number",
          "default": 10,
          "exclusiveMinimum": 0,
          "markdownDescription": "%config.health.cyclomaticThreshold%"
        },
        "lspfAnalysis.health.lengthThreshold": {
          "type": "number",
          "default": 30,
          "exclusiveMinimum": 0,
          "markdownDescription": "%config.health.lengthThreshold%"
        },
        "lspfAnalysis.health.workingMemoryThreshold": {
          "type": "number",
          "default": 8,
          "exclusiveMinimum": 0,
          "markdownDescription": "%config.health.workingMemoryThreshold%"
        },
        "lspfAnalysis.health.halsteadDifficultyThreshold": {
          "type": "number",
          "default": 12,
          "exclusiveMinimum": 0,
          "markdownDescription": "%config.health.halsteadDifficultyThreshold%"
        },
        "lspfAnalysis.health.weights.complexity": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "markdownDescription": "%config.health.weights.complexity%"
        },
        "lspfAnalysis.health.weights.length": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "markdownDescription": "%config.health.weights.length%"
        },
        "lspfAnalysis.health.weights.workingMemory": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "markdownDescription": "%config.health.weights.workingMemory%"
        },
        "lspfAnalysis.health.weights.interface": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "markdownDescription": "%config.health.weights.interface%"
        },
        "lspfAnalysis.health.parametersThreshold": {
          "type": "number",
          "default": 4,
          "exclusiveMinimum": 0,
          "markdownDescription": "%config.health.parametersThreshold%"
        },
        "lspfAnalysis.health.weights.classDesign": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "markdownDescription": "%config.health.weights.classDesign%"
        },
        "lspfAnalysis.health.wmcThreshold": {
          "type": "number",
          "default": 34,
          "exclusiveMinimum": 0,
          "markdownDescription": "%config.health.wmcThreshold%"
        },
        "lspfAnalysis.health.publicMethodsThreshold": {
          "type": "number",
          "default": 14,
          "exclusiveMinimum": 0,
          "markdownDescription": "%config.health.publicMethodsThreshold%"
        },
        "lspfAnalysis.health.publicAttributesThreshold": {
          "type": "number",
          "default": 8,
          "exclusiveMinimum": 0,
          "markdownDescription": "%config.health.publicAttributesThreshold%"
        },
        "lspfAnalysis.health.qualityWarn": {
          "type": "number",
          "default": 25,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "%config.health.qualityWarn%"
        },
        "lspfAnalysis.health.qualityError": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "%config.health.qualityError%"
        },
        "lspfAnalysis.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.diagnostics.enabled%"
        },
        "lspfAnalysis.diagnostics.perMetric": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.diagnostics.perMetric%"
        },
        "lspfAnalysis.diagnostics.file": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.diagnostics.file%"
        },
        "lspfAnalysis.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.statusBar.enabled%"
        },
        "lspfAnalysis.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.server.path%"
        },
        "lspfAnalysis.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "%config.trace.server%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "test:debug-transport": "cargo build --manifest-path ../../Cargo.toml -p lspf-analysis && npm run compile && node --test out/test/debugServer.integration.js",
    "bundle": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "prepare:server": "node scripts/prepareServer.mjs",
    "package": "node scripts/package.mjs",
    "package:pre-release": "node scripts/package.mjs --pre-release",
    "publish:pre-release": "vsce publish --pre-release --packagePath",
    "vscode:prepublish": "npm run bundle"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-ws-jsonrpc": "^3.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.106.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.0",
    "vscode-jsonrpc": "~8.2.1"
  }
}
