root = true

# Fallback for anything without a rule below.
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# rustfmt defaults: four spaces, 100 columns.
[*.rs]
indent_size = 4
max_line_length = 100

# Kotlin coding conventions: four spaces, no tabs. 120 is IntelliJ's right margin
# for Kotlin. ktlint reads all three from here, so this block is the whole Kotlin
# style configuration.
[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = intellij_idea

# Oracle's code conventions and the IntelliJ default. Google Java Style uses two
# spaces instead; switch here if you prefer it.
[*.java]
indent_size = 4
max_line_length = 100

# Prettier, the TypeScript handbook, and the VS Code extension samples all use
# two spaces. Prettier's printWidth default is 80; 100 here is a deliberate
# loosening.
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
max_line_length = 100

# clang-format's LLVM style, which Google's C++ guide also follows.
[*.{c,h,cc,cpp,cxx,hh,hpp,hxx}]
indent_size = 2
max_line_length = 80

# PEP 8 for indentation, Black for the line length.
[*.py]
indent_size = 4
max_line_length = 88

# The .NET convention. Roslyn code-style rules belong in a nested
# clients/vs/.editorconfig, not here.
[*.cs]
indent_size = 4

# Google's shell style guide.
[*.{sh,bash}]
indent_size = 2

# taplo, the de facto TOML formatter, indents with two spaces. The width is the
# one the Rust code uses, rather than taplo's narrower default.
[*.toml]
indent_size = 2
max_line_length = 100

# Data and markup formats. csproj, props, targets, vsct, vsixmanifest, resx, and
# slnx cover a Visual Studio client's project files.
[*.{json,jsonc,yml,yaml,xml,svg,html,css,scss,csproj,props,targets,vsct,vsixmanifest,resx,slnx}]
indent_size = 2

# Tree-sitter query files, as shipped by a Zed extension.
[*.scm]
indent_size = 2

# Two trailing spaces represent a Markdown line break.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Visual Studio rewrites solution files with tabs and CRLF on every save.
[*.sln]
indent_style = tab
end_of_line = crlf

# cmd.exe mis-parses LF-terminated labels, so Windows scripts stay CRLF.
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Generated by Gradle. Leave the wrapper alone so regenerating it produces no
# diff.
[clients/*/gradlew]
indent_size = 4

[clients/*/gradle/wrapper/**]
indent_size = 4
trim_trailing_whitespace = false

# Written by insta as two-space YAML; the captured output has to match byte for
# byte.
[*.snap]
indent_size = 2
trim_trailing_whitespace = false

# Written by Cargo, which indents with a single space. Never edited by hand.
[Cargo.lock]
indent_size = unset

# Snapshot test inputs. Trimming or reindenting them changes the analysis
# results, so no formatting rule applies.
[crates/*/tests/fixtures/**]
indent_style = unset
indent_size = unset
max_line_length = unset
trim_trailing_whitespace = false
