# Normalise every text file to LF in the repository and in the working tree, so
# checkouts match .editorconfig on every platform regardless of core.autocrlf.
* text=auto eol=lf

# Tools that require CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sln   text eol=crlf

# Tools that break on CRLF: /bin/sh chokes on a CRLF shebang line.
*.sh    text eol=lf
gradlew text eol=lf

# Snapshot test inputs and outputs. Line endings are part of what the analyser
# measures, so pin them rather than letting the platform decide.
crates/*/tests/fixtures/** text eol=lf
*.snap                     text eol=lf

# Binaries: never diff, never convert line endings. The binary macro only clears
# text, so clear the inherited eol as well.
*.jar    binary !eol
*.wasm   binary !eol
*.vsix   binary !eol
*.exe    binary !eol
*.dll    binary !eol
*.pdb    binary !eol
*.so     binary !eol
*.dylib  binary !eol
*.png    binary !eol
*.jpg    binary !eol
*.jpeg   binary !eol
*.gif    binary !eol
*.ico    binary !eol
*.zip    binary !eol
*.woff   binary !eol
*.woff2  binary !eol

# Language-aware hunk headers, so `git diff` names the enclosing function.
*.rs   diff=rust
*.kt   diff=kotlin
*.kts  diff=kotlin
*.java diff=java
*.py   diff=python
*.cs   diff=csharp
*.c    diff=cpp
*.h    diff=cpp
*.cc   diff=cpp
*.cpp  diff=cpp
*.hpp  diff=cpp
*.scm  diff=scheme
*.html diff=html
*.css  diff=css
*.md   diff=markdown

# Generated lock files: collapsed in GitHub diffs, excluded from language stats.
Cargo.lock        linguist-generated=true
package-lock.json linguist-generated=true

# Generated by Gradle; not this project's code.
clients/*/gradlew            linguist-vendored=true
clients/*/gradlew.bat        linguist-vendored=true
clients/*/gradle/wrapper/**  linguist-vendored=true
