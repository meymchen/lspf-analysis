# Markdown belongs to markdownlint-cli2, which keeps tables compact and leaves
# the agent-facing documents alone. See .markdownlint-cli2.jsonc.
*.md

# Build output. .intellijPlatform holds a downloaded IDE and a sandbox running
# it: tens of thousands of files, and the only reason a whole-tree run is slow
# without this entry.
target/
enums/target/
clients/intellij/build/
clients/intellij/.gradle/
clients/intellij/.intellijPlatform/
clients/intellij/.kotlin/
clients/vscode/dist/
clients/vscode/out/

# Generated: rewritten by the tool that owns them.
package-lock.json
clients/vscode/package-lock.json
.idea/
clients/intellij/gradle/

# Snapshot test inputs and outputs. Reformatting a fixture changes what the
# analyser measures, and the snapshots are compared byte for byte.
crates/*/tests/fixtures/
crates/*/tests/snapshots/
