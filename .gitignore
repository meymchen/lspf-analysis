target
enums/target
*~

# The repository's own formatters (Prettier and taplo), which are a development
# dependency of the tree as a whole rather than of any one client.
/node_modules/

# What insta writes beside a snapshot when an assertion fails. The `.snap`
# files themselves are the test baseline and belong in the repository.
*.snap.new

# Client-specific dependencies and output are covered by clients/*/.gitignore.
# Visual Studio state for the solution at the repository root.
/.vs/

# JetBrains IDEs. Only the run/debug configurations are shared, so a clone on
# another machine debugs the same way `.vscode/launch.json` lets it. The rest
# of `.idea/`, and the module files, describe one local installation and the
# IDE regenerates them on open.
.idea/*
!.idea/runConfigurations/
*.iml
